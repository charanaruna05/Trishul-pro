# ═══════════════════════════════════════════
# TRISHUL PRO — Environment Configuration
# ═══════════════════════════════════════════

# Server Config
NODE_ENV=development
PORT=3000
VITE_API_URL=http://localhost:3000

# ═══ BROKER CREDENTIALS ═══
# NEVER commit .env file — use .env.example as template

# Angel One (SmartAPI)
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Shoonya (Finvasia)
SHOONYA_UID=your_shoonya_uid_here
SHOONYA_PASSWORD=your_shoonya_password_here
SHOONYA_PIN=your_shoonya_pin_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trishul_pro
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=24h

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# AI/Gemini Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Deployment
VERCEL_ENV=development
VERCEL_URL=http://localhost:3000
